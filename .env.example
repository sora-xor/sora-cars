# The app bundles this public Taira genesis identity by default. An override must
# come from a reviewed release trust context, never an arbitrary Torii response.
# Quotes preserve the mandatory checksum after # when dotenv loads the value.
VITE_TAIRA_NETWORK_ID="hash:0466DA18C70CA8CBD51B8CC60B1D4A4802FC5D7F928D505806D7CD6CB61D60EF#BA85"
VITE_XOR_ASSET_DEFINITION=
VITE_GAME_APPLICATION_ID=
VITE_EXECUTION_PROFILE_ID=
# Independently reviewed finalized HeightContextId and its exact height.
VITE_FINALITY_CONTEXT_ID=
VITE_FINALITY_CONTEXT_HEIGHT=
# Exact executable SHA-256 from a trusted verifier release build record; never endpoint-provided.
VITE_VERIFIER_BINARY_SHA256=

# Optional, replaceable signaling service. Manual signed offers also work.
VITE_SIGNALING_URL=
# Native finalized-game HTTP worker origin (not a Torii or signaling URL).
VITE_PROOF_WORKER_URL=

# Reviewed collection identity only; metadata hashes are derived from bundled local designs.
# JSON shape: {"domain":"your_collection.universal","sellers":["<reviewed I105 seller>"]}
VITE_NFT_COLLECTION=
# Both a reviewed local release and matching qualified native market are required.
VITE_NFT_MARKET_PROFILE_ID=
VITE_NFT_MARKET_QUALIFIED=false

# Music collection shares the cosmetic collection domain when both are enabled.
# JSON shape: {"domain":"your_collection.universal","sellers":["<reviewed I105 seller>"],"licensor":"<legal rights holder name>"}
# All 26 recordings, their artwork and exact license hashes are required before release.
VITE_MUSIC_COLLECTION=
